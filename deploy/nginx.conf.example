# Place inside an HTTPS server block; configure certificates separately.
# Proxy must overwrite forwarding headers. Set DASHCAM_TRUST_PROXY=true only here.
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    # Each resumable chunk is 4 MiB. Legacy whole-file uploads need a higher limit.
    client_max_body_size 8m;
}
