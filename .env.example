# Native installation. Existing installations must keep their original absolute data path.
DASHCAM_DATA_DIR=./data
DASHCAM_HOST=127.0.0.1
DASHCAM_PORT=8080
# Compose publishes localhost only; change deliberately for LAN access.
DASHCAM_BIND_IP=127.0.0.1
DASHCAM_COOKIE_SECURE=false
DASHCAM_TRUST_PROXY=false
DASHCAM_SFTP_ENABLED=false
DASHCAM_SFTP_PUBLIC_HOST=localhost
DASHCAM_JOB_CONCURRENCY=1
DASHCAM_JOBS_PER_USER=1
DASHCAM_TRIM_THREADS=2
DASHCAM_MIN_FREE_DISK_BYTES=1073741824
DASHCAM_MAX_SESSION_BYTES=53687091200
