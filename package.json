{
  "name": "dashcam",
  "version": "2.0.0",
  "description": "行車記錄器網頁系統 — 上傳、整理、合併、瀏覽行車影片(Node.js + Fastify + TypeScript)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dashcam-import": "dist/cli/import-prebuilt.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "import": "tsx src/cli/import-prebuilt.ts",
    "migrate-tz": "tsx src/cli/migrate-tz.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "11.0.0",
    "@fastify/static": "9.1.3",
    "better-sqlite3": "12.11.1",
    "fastify": "5.8.5",
    "ssh2": "1.17.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.6",
    "@types/ssh2": "1.15.5",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
