{
  "name": "dashcam",
  "version": "2.3.0",
  "description": "\u884c\u8eca\u8a18\u9304\u5668\u7db2\u9801\u7cfb\u7d71 \u2014 \u4e0a\u50b3\u3001\u6574\u7406\u3001\u5408\u4f75\u3001\u700f\u89bd\u884c\u8eca\u5f71\u7247(Node.js + Fastify + TypeScript)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dashcam-import": "dist/cli/import-prebuilt.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "doctor": "node --env-file-if-exists=.env dist/cli/doctor.js",
    "backup": "node --env-file-if-exists=.env dist/cli/backup.js",
    "import": "tsx src/cli/import-prebuilt.ts",
    "migrate-tz": "tsx src/cli/migrate-tz.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:ui": "playwright test test/ui-zz-screens.spec.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/background.ts src/media src/uploads/resumable.ts src/routes/background.ts src/storage src/diagnostics.ts src/cli/backup.ts src/cli/doctor.ts src/dashcams/generic.ts src/util/file-hash.ts static/jobs.js static/themes.js static/timeline.js static/playback-sync.js static/themes.css"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.2",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.4",
    "ssh2": "1.17.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.6",
    "@types/ssh2": "1.15.5",
    "prettier": "3.6.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
